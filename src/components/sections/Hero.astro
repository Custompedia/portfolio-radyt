---
/**
 * Hero berisi dua hal:
 *  1. konten yang memang hanya milik hero (wordmark, potret, kolom teks),
 *  2. penanda posisi untuk elemen sidebar — kotak `.ghost` tak terlihat untuk
 *     kartu & tombol, dan baris label transparan untuk navigasi. Lihat
 *     modules/ghost.ts.
 *
 * Dipecah jadi DUA lapisan sticky karena sidebar (z-index 60) harus berada
 * di ATAS potret tapi di BAWAH kolom teks — persis seperti referensi, di mana
 * baris navigasi tersembunyi di belakang konten.
 *
 * SUSUNAN: potret duduk di paruh KANAN layar dan seluruh teks berdiri di kolom
 * KIRI. Tidak ada satu pun teks yang menumpang di atas wajah — itu syarat dari
 * handoff, dan itu pula yang membuat kolom kiri boleh jadi satu kolom mengalir
 * (`.hero-copy`) alih-alih enam elemen yang masing-masing dijangkar sendiri.
 *
 * Wordmark raksasa MENGERUT ke pill brand di pojok kiri atas saat scroll
 * (lihat buildWordmarkMorph di modules/ghost.ts). Yang terbang bukan elemen
 * sidebar-nya, melainkan wordmark ini sendiri: ia harus tetap di `.hero-back`
 * supaya berada di belakang potret, sementara elemen sidebar z-index-nya di
 * atas. Di ujung lintasan keduanya berimpit persis, jadi serah-terimanya
 * cukup lewat silang-pudar — tanpa perlu menukar z-index di tengah scroll.
 */
import Icon from '../Icon.astro';
import { brand, hero, nav, stats } from '../../data/site';

interface GhostBox {
  id: string;
  x: string;
  y: string;
  w: string;
  h: string;
}

/**
 * KARTU STATISTIK — tinggal SATU di hero.
 *
 * Handoff membatasi bukti di hero jadi satu angka saja (12+ tahun) dan
 * melarang menambah hitungan klien, proyek, atau perusahaan di sana. Kartu
 * kedua di rail ("3 Companies") karena itu tidak punya asal-usul di hero: ia
 * ikut kelompok `data-ghost-fade` dan menyala saat rail merakit diri.
 *
 * Geometri kartu yang tersisa diambil dari kartu besar hero referensi
 * (heynesh.com, viewport 1568x782, lewat getBoundingClientRect): w 9.62vw,
 * h 10.44vw — kotak, bukan pita lebar. Posisinya digeser ke kanan sampai duduk
 * di pundak kiri subjek, jadi ia melayang di atas potret dan bukan di atas
 * kolom teks.
 */
const STAT_W = 9.62;
const STAT_H = 10.44;
const STAT_X = 46.5;

/**
 * Tepi atas kartu, dijangkar ke kaki wordmark (--hero-nav-top) dan bukan ke
 * angka vh lepas: wordmark, baris nav, dan kartu ini harus turun-naik bersama
 * saat lebar layar berubah. `min(...)` cuma jaring pengaman layar lebar-pendek
 * supaya kaki kartu tetap di dalam layar.
 */
const statY = `min(calc(var(--hero-nav-top) + 5.5vw), calc(94vh - ${STAT_H}vw))`;

/**
 * Lebar blok angka di dalam kartu. Ghost `stat-1` menentukan SKALA blok (lebar
 * ghost ÷ lebar aslinya di rail, lihat buildTween), jadi angka inilah yang
 * menentukan besar teks di hero — bukan font-size di components.css.
 *
 * DIUKUR pada susunan bertumpuk "12+ / Years" sebagaimana ia tampil di rail:
 * lebar 3.29vw, tinggi 0.9091 × lebar. Kalau label di site.ts diganti, kedua
 * angka ini WAJIB diukur ulang — keduanya milik string itu, bukan konstanta.
 */
const STAT_TEXT_W = 6.6;
const STAT_TEXT_ASPECT = 0.9091;
const STAT_TEXT_H = STAT_TEXT_W * STAT_TEXT_ASPECT;

/**
 * Hanya elemen yang memang terlihat di hero yang diberi ghost: kartu statistik
 * dan tombol utama. Navigasi punya jalurnya sendiri (baris label transparan di
 * `.hero-front`), dan tombol utama malah tidak dijangkar di sini sama sekali —
 * kotaknya ikut mengalir di dalam `.hero-copy` (lihat `.ghost--flow`), jadi ia
 * tidak bisa lepas sinkron dari teks di atasnya. Sisanya — logo, ikon sosial,
 * kartu email, marquee klien — sengaja tidak punya posisi hero: mereka fade-in
 * selama morph lewat `data-ghost-fade`.
 *
 * `x`/`y` menentukan sudut kiri-atas blok, `w` menentukan skalanya; `h` tidak
 * dibaca engine dan diisi apa adanya sebagai dokumentasi.
 */
const ghosts: GhostBox[] = [
  { id: 'stats-card-1', x: `${STAT_X}vw`, y: statY, w: `${STAT_W}vw`, h: `${STAT_H}vw` },
  {
    id: 'stat-1',
    x: `${STAT_X + (STAT_W - STAT_TEXT_W) / 2}vw`,
    y: `calc(${statY} + ${(STAT_H - STAT_TEXT_H) / 2}vw)`,
    w: `${STAT_TEXT_W}vw`,
    h: `${STAT_TEXT_H}vw`,
  },
];

/**
 * Baris navigasi hero terbelah dua dengan celah di tengah untuk potret. Tanpa
 * belahan ini, label tengah tertutup kepala dan tidak terbaca sama sekali.
 *
 * Belahannya DUA-TIGA, sama seperti referensi ("HOME | ABOUT ME" di kiri,
 * "SERVICES | CLIENTS | FAQ" di kanan) — dan dengan lima menu pembagiannya
 * jatuh persis di situ tanpa perlu angka tambahan.
 */
const navLeft = nav.slice(0, 2);
const navRight = nav.slice(2);

/** Kartu tahun mobile memakai stat yang sama dengan kartu hero desktop. */
const heroStat = stats.find((stat) => stat.inHero);
---

<section class="hero" id="home" data-hero>
  <!-- Lapisan belakang: di bawah sidebar. -->
  <div class="hero-back">
    <!-- Wordmark ini merangkap dua peran: elemen intro (terbang masuk dari
         kanan, hurufnya naik satu per satu) sekaligus latar hero. Tiap huruf
         punya mask sendiri supaya bisa naik dari balik garis. -->
    <!-- Dua lapis, dan pembagian tugasnya tegas:
         `.hero-wordmark`       — kotak selebar layar, hanya untuk menengahkan;
                                  transform-nya milik intro (terbang dari kanan).
         `.hero-wordmark-inner` — kotak sepas teks; transform-nya milik morph
                                  scroll. Dipisah karena keduanya menulis x/y,
                                  dan karena skala morph hanya benar kalau titik
                                  jangkarnya sudut kiri-atas TEKS, bukan sudut
                                  kotak selebar layar. -->
    <p class="hero-wordmark" aria-label={brand.name} data-hero-wordmark>
      <span class="hero-wordmark-inner" data-wordmark-inner>
        {
          [...brand.name].map((letter) => (
            <span class="wordmark-letter-mask" aria-hidden="true">
              <span class="wordmark-letter" data-wordmark-letter>
                {letter}
              </span>
            </span>
          ))
        }
      </span>
    </p>

    <!-- Potret tidak mengecil, ia melebur: blur naik sampai 90px sementara
         opacity turun sampai NOL. Sebelumnya berhenti di 0.3, dan sisa 0.3 itu
         yang terbaca sebagai noda gelap di belakang kartu About.
         Selesai di 55%, bukan 70%: About ditarik naik lewat margin negatif dan
         mulai menumpuk hero sekitar 57%, jadi potretnya harus sudah padam
         sebelum itu — kalau tidak, nodanya tetap muncul betapapun tipisnya. -->
    <div
      class="hero-portrait"
      data-tl-type="scroll"
      data-tl-trigger="[data-hero]"
      data-tl-start="0% top"
      data-tl-end="55% top"
      data-tl-from="{'filter':'blur(0px)','opacity':1}"
      data-tl-to="{'filter':'blur(90px)','opacity':0}"
      data-tl-desktop
    >
      <!-- Foto studio yang latarnya sudah dipotong; lihat public/images/README.md. -->
      <img
        src="/images/portrait.webp"
        alt={`${brand.person} — ${brand.role}`}
        width="810"
        height="1365"
        fetchpriority="high"
      />
    </div>

    <!-- Kartu tahun mengambang di atas potret — HANYA dirender/terlihat di
         mobile (lihat sections.css, `.hero-mobile-stat`). Ghost engine
         desktop (modules/ghost.ts) `desktopOnly:true` dan mencari elemen
         lewat `[data-ghost]`; markup ini SENGAJA tidak punya atribut itu jadi
         tidak pernah ikut terukur atau dobel dengan kartu asli di sidebar. -->
    {
      heroStat && (
        <div class="hero-mobile-stat hero-mobile-stat-float glass-card">
          <span class="hero-mobile-stat-value">{heroStat.value}</span>
          <span class="hero-mobile-stat-label">{heroStat.label}</span>
        </div>
      )
    }

    {
      ghosts.map((g) => (
        <span class="ghost" data-ghost-target={g.id} style={`--gx:${g.x};--gy:${g.y};--gw:${g.w};--gh:${g.h}`} />
      ))
    }
  </div>

  <!-- Lapisan depan: di atas sidebar, menutupi baris navigasi. -->
  <div class="hero-front">
    <!--
      Label di baris ini transparan: yang terlihat adalah link sidebar asli yang
      diterbangkan ke posisinya oleh ghost.ts. Jadi baris ini murni penanda tata
      letak — dan karena ia baris flex sungguhan, posisi tiap link tidak perlu
      dihitung manual di runtime.
    -->
    <div class="hero-nav" aria-hidden="true">
      <div class="hero-nav-group">
        {
          navLeft.map((item, i) => (
            <>
              {i > 0 && (
                <span
                  class="hero-nav-sep"
                  data-tl-type="scroll"
                  data-tl-trigger="[data-hero]"
                  data-tl-start="0% top"
                  data-tl-end={`${i + 1}% top`}
                  data-tl-from="{'opacity':1,'y':0}"
                  data-tl-to="{'autoAlpha':0,'y':'1vw'}"
                  data-tl-desktop
                />
              )}
              {/* Ikon ikut dirender walau tak terlihat: kotak label harus
                  persis seukuran link sidebar, kalau tidak rasio lebarnya
                  bukan 1 dan navigasi ikut mengecil saat terbang ke hero. */}
              <span class="hero-nav-link" data-ghost-target={`nav-${item.id}`}>
                <span class="hero-nav-icon">
                  <Icon name={item.icon} size={14} />
                </span>
                {item.label}
              </span>
            </>
          ))
        }
      </div>

      <div class="hero-nav-group">
        {
          navRight.map((item, i) => (
            <>
              {i > 0 && (
                <span
                  class="hero-nav-sep"
                  data-tl-type="scroll"
                  data-tl-trigger="[data-hero]"
                  data-tl-start="0% top"
                  data-tl-end={`${i + 2}% top`}
                  data-tl-from="{'opacity':1,'y':0}"
                  data-tl-to="{'autoAlpha':0,'y':'1vw'}"
                  data-tl-desktop
                />
              )}
              <span class="hero-nav-link" data-ghost-target={`nav-${item.id}`}>
                <span class="hero-nav-icon">
                  <Icon name={item.icon} size={14} />
                </span>
                {item.label}
              </span>
            </>
          ))
        }
      </div>
    </div>

    <!-- Satu kolom mengalir, bukan enam elemen yang dijangkar sendiri-sendiri.
         Karena tidak ada lagi teks yang harus menghindari wajah, urutan bacanya
         bisa diserahkan ke aliran normal — dan seluruh blok keluar layar
         sebagai SATU gerakan, bukan lima yang kebetulan sinkron. -->
    <div
      class="hero-copy"
      data-tl-type="scroll"
      data-tl-trigger="[data-hero]"
      data-tl-start="4% top"
      data-tl-end="11% top"
      data-tl-from="{'opacity':1,'yPercent':0}"
      data-tl-to="{'yPercent':-60,'autoAlpha':0}"
      data-tl-desktop
    >
      <p class="hero-eyebrow">{hero.eyebrow}</p>

      <!-- Nama versi terbaca. Wordmark raksasa di latar hanya memuat "RADHYTA",
           jadi tanpa baris ini nama lengkapnya tidak pernah muncul utuh. -->
      <p class="hero-name">{hero.name}</p>

      <h1 class="hero-headline">
        {hero.headline.map((line) => <span class="hero-headline-line">{line}</span>)}
      </h1>

      <p class="hero-subheadline">{hero.subheadline}</p>

      <!-- CTA primer = tombol solid (elemen aslinya di rail, yang terbang ke
           kotak di bawah). CTA sekunder = teks berpanah, BUKAN tombol kedua. -->
      <div class="hero-cta-row">
        <span class="ghost ghost--flow" data-ghost-target="cta-primary"></span>
        <a class="hero-secondary" href={hero.ctaSecondary.href} data-button-hover>
          <span>{hero.ctaSecondary.label}</span>
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>

    <!-- Satu baris, dipisah titik tengah. Bukan chip, bukan grid. -->
    <p
      class="hero-brands"
      data-tl-type="scroll"
      data-tl-trigger="[data-hero]"
      data-tl-start="4% top"
      data-tl-end="11% top"
      data-tl-from="{'opacity':1,'y':0}"
      data-tl-to="{'y':'2vw','autoAlpha':0}"
      data-tl-desktop
    >
      {
        hero.brands.map((name, i) => (
          <>
            {i > 0 && <span class="hero-brands-sep" aria-hidden="true">·</span>}
            <span>{name}</span>
          </>
        ))
      }
    </p>
  </div>
</section>
