---
/**
 * Hero berisi dua hal:
 *  1. konten yang memang hanya milik hero (wordmark, potret, headline, traits),
 *  2. kotak `.ghost` tak terlihat — cuma penanda posisi & ukuran awal untuk
 *     elemen sidebar. Lihat scripts/modules/ghost.ts.
 *
 * Dipecah jadi DUA lapisan sticky karena sidebar (z-index 60) harus berada
 * di ATAS potret tapi di BAWAH headline & kartu traits — persis seperti
 * referensi, di mana baris navigasi tersembunyi di belakang konten tengah.
 *
 * Posisi ghost ditulis dalam vw/vh lewat custom property supaya komposisinya
 * ikut menyesuaikan ukuran layar tanpa media query berlapis.
 */
import Icon from '../Icon.astro';
import { brand, hero } from '../../data/site';

interface GhostBox {
  id: string;
  x: string;
  y: string;
  w: string;
  h: string;
  row?: boolean;
}

/**
 * Hanya elemen yang memang terlihat di hero referensi yang diberi ghost:
 * kartu statistik, baris navigasi, tombol utama, dan teks blurb. Sisanya
 * (logo, ikon sosial, kartu email, marquee klien) sengaja tidak punya posisi
 * hero — mereka fade-in selama morph lewat `data-ghost-fade`.
 */
const ghosts: GhostBox[] = [
  // `max()` memberi lantai piksel: tanpa itu, di layar sempit ghost jadi lebih
  // kecil dari elemen aslinya dan teks statistik justru menyusut, bukan membesar.
  { id: 'stats-card-0', x: '17.5vw', y: '57vh', w: 'max(200px, 14.2vw)', h: '14vh' },
  { id: 'stat-0', x: '19vw', y: '60vh', w: 'max(165px, 11.2vw)', h: '8vh' },

  { id: 'stats-card-1', x: '18.5vw', y: '75vh', w: 'max(165px, 12vw)', h: '20vh' },
  { id: 'stat-1', x: '19.6vw', y: '78vh', w: 'max(140px, 9.6vw)', h: '10vh' },

  { id: 'menu-card', x: '2vw', y: '61vh', w: '96vw', h: '6.4vh', row: true },

  // Ukurannya identik dengan tombol "About Me" di sebelahnya (lihat
  // .hero-secondary). Karena tipenya `size`, lebar/tinggi inilah yang dipakai
  // apa adanya — labelnya tidak ikut mengecil.
  {
    id: 'cta-primary',
    x: 'calc(50vw - var(--hero-btn-w) - 8px)',
    y: '77.5vh',
    w: 'var(--hero-btn-w)',
    h: 'var(--hero-btn-h)',
  },

  { id: 'tagline', x: '74.6vw', y: '80vh', w: '21.8vw', h: '10vh' },
];
---

<section class="hero" id="home" data-hero>
  <!-- Lapisan belakang: di bawah sidebar. -->
  <div class="hero-back">
    <!-- Wordmark ini merangkap dua peran: elemen intro (terbang masuk dari
         kanan, hurufnya naik satu per satu) sekaligus latar hero. Tiap huruf
         punya mask sendiri supaya bisa naik dari balik garis. -->
    <p class="hero-wordmark" aria-label={brand.name} data-hero-wordmark data-tl-type="scroll" data-tl-trigger="[data-hero]" data-tl-start="0% top" data-tl-end="34% top" data-tl-from="{'opacity':1}" data-tl-to="{'yPercent':-45,'opacity':0}">
      {
        [...brand.name].map((letter) => (
          <span class="wordmark-letter-mask" aria-hidden="true">
            <span class="wordmark-letter" data-wordmark-letter>
              {letter}
            </span>
          </span>
        ))
      }
    </p>

    <div class="hero-portrait" data-tl-type="scroll" data-tl-trigger="[data-hero]" data-tl-start="0% top" data-tl-end="40% top" data-tl-from="{'opacity':1}" data-tl-to="{'scale':1.35,'opacity':0}">
      <img src="/images/portrait.svg" alt="" width="640" height="900" fetchpriority="high" />
    </div>

    {
      ghosts.map((g) => (
        <span
          class="ghost"
          data-ghost-target={g.id}
          data-ghost-row={g.row ? 'menu' : undefined}
          style={`--gx:${g.x};--gy:${g.y};--gw:${g.w};--gh:${g.h}`}
        />
      ))
    }
  </div>

  <!-- Lapisan depan: di atas sidebar, menutupi baris navigasi. -->
  <div class="hero-front">
    <h1 class="hero-headline" data-tl-type="scroll" data-tl-trigger="[data-hero]" data-tl-start="0% top" data-tl-end="30% top" data-tl-from="{'opacity':1}" data-tl-to="{'y':-160,'opacity':0}">
      {hero.headline.map((line) => <span class="hero-headline-line">{line}</span>)}
    </h1>

    <div class="hero-traits" data-tl-type="scroll" data-tl-trigger="[data-hero]" data-tl-start="0% top" data-tl-end="28% top" data-tl-from="{'opacity':1}" data-tl-to="{'x':140,'opacity':0}">
      {
        hero.traits.map((trait) => (
          <span class="hero-trait">
            <span class="hero-trait-mark" aria-hidden="true" />
            {trait}
          </span>
        ))
      }
    </div>

    <p class="hero-eyebrow" data-tl-type="scroll" data-tl-trigger="[data-hero]" data-tl-start="0% top" data-tl-end="26% top" data-tl-from="{'opacity':1}" data-tl-to="{'y':70,'opacity':0}">
      <span>{hero.eyebrow}</span>
      <span>{hero.eyebrowSecond}</span>
    </p>

    <a class="btn hero-secondary" href={hero.ctaSecondary.href} data-tl-type="scroll" data-tl-trigger="[data-hero]" data-tl-start="0% top" data-tl-end="24% top" data-tl-from="{'opacity':1}" data-tl-to="{'y':60,'opacity':0}" data-button-hover>
      <span class="btn-label">{hero.ctaSecondary.label}</span>
    </a>

    <span class="hero-scroll" aria-hidden="true" data-tl-type="scroll" data-tl-trigger="[data-hero]" data-tl-start="0% top" data-tl-end="14% top" data-tl-from="{'opacity':1}" data-tl-to="{'opacity':0}">
      <Icon name="arrow" size={13} />
      Scroll
    </span>
  </div>
</section>
