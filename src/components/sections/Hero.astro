---
/**
 * Hero berisi dua hal:
 *  1. konten yang memang hanya milik hero (wordmark, potret, headline, traits),
 *  2. penanda posisi untuk elemen sidebar — kotak `.ghost` tak terlihat untuk
 *     kartu, dan baris label transparan untuk navigasi. Lihat modules/ghost.ts.
 *
 * Dipecah jadi DUA lapisan sticky karena sidebar (z-index 60) harus berada
 * di ATAS potret tapi di BAWAH headline & kartu traits — persis seperti
 * referensi, di mana baris navigasi tersembunyi di belakang konten tengah.
 *
 * Posisi ghost ditulis dalam vw/vh lewat custom property supaya komposisinya
 * ikut menyesuaikan ukuran layar tanpa media query berlapis. Angkanya diukur
 * langsung dari hero referensi pada 1492x882.
 *
 * Wordmark raksasa MENGERUT ke pill brand di pojok kiri atas saat scroll
 * (lihat buildWordmarkMorph di modules/ghost.ts). Yang terbang bukan elemen
 * sidebar-nya, melainkan wordmark ini sendiri: ia harus tetap di `.hero-back`
 * supaya berada di belakang potret, sementara elemen sidebar z-index-nya di
 * atas. Di ujung lintasan keduanya berimpit persis, jadi serah-terimanya
 * cukup lewat silang-pudar — tanpa perlu menukar z-index di tengah scroll.
 */
import Icon from '../Icon.astro';
import { brand, hero, nav, stats } from '../../data/site';

interface GhostBox {
  id: string;
  x: string;
  y: string;
  w: string;
  h: string;
}

/**
 * Hanya elemen yang memang terlihat di hero referensi yang diberi ghost:
 * kartu statistik, tombol utama, dan teks blurb. Navigasi punya jalurnya
 * sendiri (baris label transparan di bawah). Sisanya — logo, ikon sosial,
 * kartu email, marquee klien — sengaja tidak punya posisi hero: mereka
 * fade-in selama morph lewat `data-ghost-fade`.
 */
/**
 * PASANGAN KARTU STATISTIK — geometrinya DIUKUR LANGSUNG dari hero referensi
 * (heynesh.com, viewport 1568x782, lewat getBoundingClientRect):
 *
 *   kartu atas  ".nav-webflow-bg"     x 17.87vw  w 14.89vw  h  7.25vw
 *   jarak                                                     1.575vw
 *   kartu bawah ".nav-experience-bg"  x 20.95vw  w  9.62vw  h 10.44vw
 *
 * Dua hal yang khas dan sengaja ditiru: kartu ATAS lebar-pendek sementara
 * kartu BAWAH kotak, dan kartu bawah menjorok ~3vw ke kanan — bukan rata kiri
 * satu kolom seperti versi sebelumnya.
 *
 * Bentuk itu mengikuti ISI masing-masing, bukan sebaliknya (lihat `.nav-stat`
 * di components.css):
 *   kartu atas  isinya BERDAMPINGAN — "950+" lalu "Businesses / served" di
 *               kanannya, jadi kotaknya memang harus lebar-pendek;
 *   kartu bawah isinya BERTUMPUK — "12+" besar di atas labelnya, jadi kotaknya
 *               kotak. Ukuran 9.62 x 10.44vw persis angka referensi.
 * Lebar kartu atas dibuat sedikit lebih lega agar angka dan label tidak terasa
 * sesak, sementara anchor kiri dan posisi vertikalnya tetap sama.
 */
const STAT_SM_X = 21.75;
const STAT_SM_W = 12;
const STAT_SM_H = 4.8;
const STAT_GAP = 3.2;
const STAT_BIG_X = 23.1;
const STAT_BIG_W = 9.62;
const STAT_BIG_H = 10.44;

/**
 * Tepi atas kartu atas. Di referensi kartu ini SEJAJAR dengan baris navigasi
 * (tepi atas kartu 457px, tepi atas nav 455px) — baris nav lewat di sepertiga
 * atas kartu, dan itu yang bikin keduanya terbaca sebagai satu baris.
 * Karena itu jangkarnya --hero-nav-top, bukan angka vh lepas: nav dan kartu
 * tidak mungkin lagi lepas sinkron saat wordmark berganti ukuran.
 *
 * `min(...)` cuma jaring pengaman layar lebar-pendek: kalau pasangan kartu
 * (18.44vw) tidak lagi muat di bawah nav, kartunya naik supaya kakinya tetap
 * di dalam layar.
 */
const STAT_PAIR_H = STAT_SM_H + STAT_GAP + STAT_BIG_H;
/**
 * Kartu tidak lagi sejajar baris nav seperti referensi: keduanya digeser turun
 * dan ke kanan supaya duduk di atas TUBUH subjek — kartu atas di pundak kiri,
 * kartu bawah di siku kiri. Karena itu jangkarnya nav-top + 4vw.
 *
 * Tepi kanan pasangan tetap berada di sekitar kolom headline; pelebaran kartu
 * atas berhenti di 33.75vw agar isi dapat membesar tanpa mengubah anchor kirinya.
 */
const statsSmY = `min(calc(var(--hero-nav-top) + 4vw), calc(97vh - ${STAT_PAIR_H}vw))`;
const statsBigY = `calc(${statsSmY} + ${STAT_SM_H + STAT_GAP}vw)`;

/**
 * Lebar blok angka di dalam tiap kartu. Ghost `stat-*` menentukan SKALA blok
 * (lebar ghost ÷ lebar aslinya di rail, lihat buildTween), jadi angka inilah
 * yang menentukan besar teks di hero — bukan font-size di components.css.
 *
 * Yang diukur adalah susunan sebagaimana blok itu tampil DI HERO — bukan di
 * rail. Keduanya beda bentuk karena susunannya memang beda (lihat `.nav-stat`
 * dan `.nav-stat.is-inline` di components.css):
 *   stats[0] `is-inline` (berdampingan)  9.232vw lebar, tinggi 0.2338 × lebar
 *   stats[1] bawaan      (bertumpuk)     4.606vw lebar, tinggi 0.9353 × lebar
 * Lebar yang dipilih di bawah menyisakan napas seimbang di kartunya:
 *   9.4vw  → tinggi 2.20vw di kartu 12 x 4.8vw
 *   6.8vw  → tinggi 6.36vw di kartu 9.62 x 10.44vw
 *
 * Angka di kartu bawah jadi jauh lebih besar (~45px lawan ~27px) — itu yang
 * bikin pasangan ini terbaca sebagai satu kartu kecil dan satu kartu utama,
 * sama seperti "80+ Projects" dan "7+ Years" di referensi.
 */
const STAT_SM_TEXT_W = 9.4;
const STAT_SM_TEXT_H = STAT_SM_TEXT_W * 0.2338;
const STAT_BIG_TEXT_W = 6.8;
const STAT_BIG_TEXT_H = STAT_BIG_TEXT_W * 0.9353;

const ghosts: GhostBox[] = [
  /*
   * URUTAN KARTU IKUT URUTAN DI RAIL, dan itu bukan kebetulan.
   *
   * Di rail kedua kartu berdampingan: stats[0] di KIRI, stats[1] di KANAN.
   * Kalau di hero urutannya dibalik (kartu atas = stats[1], seperti versi
   * sebelumnya), pembacaannya ikut terbalik saat morph — angka yang tadinya di
   * atas mendarat di kanan dan yang di bawah mendarat di kiri, jadi keduanya
   * terlihat BERTUKAR TEMPAT di tengah scroll. Dengan atas = stats[0], urutan
   * baca hero (atas→bawah) sama dengan urutan rail (kiri→kanan) dan lintasan
   * keduanya tidak pernah bersilangan.
   *
   * Kebetulan ini juga pasangan yang sama dengan referensi: kartu kecil di atas
   * memegang angka hitungan ("80+ Projects" di sana, "950+ Businesses served"
   * di sini), kartu besar di bawah memegang angka tahun.
   */
  { id: 'stats-card-0', x: `${STAT_SM_X}vw`, y: statsSmY, w: `${STAT_SM_W}vw`, h: `${STAT_SM_H}vw` },
  /*
   * Blok angka. `w` menentukan SKALA blok (lebar ghost ÷ lebar aslinya di rail,
   * lihat buildTween), `x`/`y` menentukan sudut kiri-atasnya. `h` tidak dibaca
   * engine — diisi apa adanya sebagai dokumentasi.
   *
   * x/y menengahkan blok itu di dalam kartunya: separuh sisa lebar di kiri,
   * separuh sisa tinggi di atas. Kartu ini TIDAK berisi logo seperti versi
   * referensi, jadi bloknya berdiri sendiri di tengah alih-alih mepet kanan.
   */
  {
    id: 'stat-0',
    x: `${STAT_SM_X + (STAT_SM_W - STAT_SM_TEXT_W) / 2}vw`,
    y: `calc(${statsSmY} + ${(STAT_SM_H - STAT_SM_TEXT_H) / 2}vw)`,
    w: `${STAT_SM_TEXT_W}vw`,
    h: `${STAT_SM_TEXT_H}vw`,
  },

  // Kartu bawah — kotak dan menjorok ke kanan, lihat komentar geometri di
  // atas. Blok angkanya bertumpuk, ditengahkan dengan cara yang sama.
  { id: 'stats-card-1', x: `${STAT_BIG_X}vw`, y: statsBigY, w: `${STAT_BIG_W}vw`, h: `${STAT_BIG_H}vw` },
  {
    id: 'stat-1',
    x: `${STAT_BIG_X + (STAT_BIG_W - STAT_BIG_TEXT_W) / 2}vw`,
    y: `calc(${statsBigY} + ${(STAT_BIG_H - STAT_BIG_TEXT_H) / 2}vw)`,
    w: `${STAT_BIG_TEXT_W}vw`,
    h: `${STAT_BIG_TEXT_H}vw`,
  },

  {
    id: 'cta-primary',
    x: 'calc(50vw - var(--hero-btn-w) - 0.28vw)',
    // Sepasang dengan `.hero-secondary`, yang memakai token yang sama.
    y: 'var(--hero-cta-top)',
    w: 'var(--hero-btn-w)',
    h: 'var(--hero-btn-h)',
  },

  // `x` sengaja token, bukan angka: tepi kirinya harus lurus dengan kartu
  // traits di atasnya, dan keduanya membaca --hero-traits-left.
  { id: 'tagline', x: 'var(--hero-traits-left)', y: '87vh', w: '22.8vw', h: '7.4vh' },
];

/**
 * Baris navigasi hero terbelah dua dengan celah di tengah untuk potret. Tanpa
 * belahan ini, label tengah tertutup kepala dan tidak terbaca sama sekali.
 *
 * Belahannya DUA-TIGA, sama seperti referensi ("HOME | ABOUT ME" di kiri,
 * "SERVICES | CLIENTS | FAQ" di kanan), dan itu wajib: kolom kartu statistik
 * mulai di 17.87vw, sementara grup kiri berisi tiga label berhenti di 22.7vw —
 * label ketiga ("WORK") persis tertimpa kartu atas. Dengan dua label grup kiri
 * berhenti di ~15vw dan kartunya berdiri bebas, seperti di referensi.
 */
const navLeft = nav.slice(0, 2);
const navRight = nav.slice(2);
---

<section class="hero" id="home" data-hero>
  <!-- Lapisan belakang: di bawah sidebar. -->
  <div class="hero-back">
    <!-- Wordmark ini merangkap dua peran: elemen intro (terbang masuk dari
         kanan, hurufnya naik satu per satu) sekaligus latar hero. Tiap huruf
         punya mask sendiri supaya bisa naik dari balik garis. -->
    <!-- Dua lapis, dan pembagian tugasnya tegas:
         `.hero-wordmark`       — kotak selebar layar, hanya untuk menengahkan;
                                  transform-nya milik intro (terbang dari kanan).
         `.hero-wordmark-inner` — kotak sepas teks; transform-nya milik morph
                                  scroll. Dipisah karena keduanya menulis x/y,
                                  dan karena skala morph hanya benar kalau titik
                                  jangkarnya sudut kiri-atas TEKS, bukan sudut
                                  kotak selebar layar. -->
    <p class="hero-wordmark" aria-label={brand.name} data-hero-wordmark>
      <span class="hero-wordmark-inner" data-wordmark-inner>
        {
          [...brand.name].map((letter) => (
            <span class="wordmark-letter-mask" aria-hidden="true">
              <span class="wordmark-letter" data-wordmark-letter>
                {letter}
              </span>
            </span>
          ))
        }
      </span>
    </p>

    <!-- Potret tidak mengecil, ia melebur: blur naik sampai 90px sementara
         opacity turun sampai NOL. Sebelumnya berhenti di 0.3, dan sisa 0.3 itu
         yang terbaca sebagai noda gelap di belakang kartu About.
         Selesai di 55%, bukan 70%: About ditarik naik lewat margin negatif dan
         mulai menumpuk hero sekitar 57%, jadi potretnya harus sudah padam
         sebelum itu — kalau tidak, nodanya tetap muncul betapapun tipisnya. -->
    <div
      class="hero-portrait"
      data-tl-type="scroll"
      data-tl-trigger="[data-hero]"
      data-tl-start="0% top"
      data-tl-end="55% top"
      data-tl-from="{'filter':'blur(0px)','opacity':1}"
      data-tl-to="{'filter':'blur(90px)','opacity':0}"
      data-tl-desktop
    >
      <!-- Foto studio yang latarnya sudah dipotong; lihat public/images/README.md. -->
      <img
        src="/images/portrait.webp"
        alt={`${brand.person} — ${brand.role}`}
        width="810"
        height="1365"
        fetchpriority="high"
      />
    </div>

    <!-- Kartu tahun mengambang di atas potret — HANYA dirender/terlihat di
         mobile (lihat sections.css, `.hero-mobile-stat`). Ghost engine
         desktop (modules/ghost.ts) `desktopOnly:true` dan mencari elemen
         lewat `[data-ghost]`; markup ini SENGAJA tidak punya atribut itu jadi
         tidak pernah ikut terukur atau dobel dengan kartu asli di sidebar. -->
    {
      stats[1] && (
        <div class="hero-mobile-stat hero-mobile-stat-float glass-card">
          <span class="hero-mobile-stat-value">{stats[1].value}</span>
          <span class="hero-mobile-stat-label">{stats[1].label}</span>
        </div>
      )
    }

    {
      ghosts.map((g) => (
        <span class="ghost" data-ghost-target={g.id} style={`--gx:${g.x};--gy:${g.y};--gw:${g.w};--gh:${g.h}`} />
      ))
    }
  </div>

  <!-- Lapisan depan: di atas sidebar, menutupi baris navigasi. -->
  <div class="hero-front">
    <!--
      Label di baris ini transparan: yang terlihat adalah link sidebar asli yang
      diterbangkan ke posisinya oleh ghost.ts. Jadi baris ini murni penanda tata
      letak — dan karena ia baris flex sungguhan, posisi tiap link tidak perlu
      dihitung manual di runtime.
    -->
    <div class="hero-nav" aria-hidden="true">
      <div class="hero-nav-group">
        {
          navLeft.map((item, i) => (
            <>
              {i > 0 && (
                <span
                  class="hero-nav-sep"
                  data-tl-type="scroll"
                  data-tl-trigger="[data-hero]"
                  data-tl-start="0% top"
                  data-tl-end={`${i + 1}% top`}
                  data-tl-from="{'opacity':1,'y':0}"
                  data-tl-to="{'autoAlpha':0,'y':'1vw'}"
                  data-tl-desktop
                />
              )}
              {/* Ikon ikut dirender walau tak terlihat: kotak label harus
                  persis seukuran link sidebar, kalau tidak rasio lebarnya
                  bukan 1 dan navigasi ikut mengecil saat terbang ke hero. */}
              <span class="hero-nav-link" data-ghost-target={`nav-${item.id}`}>
                <span class="hero-nav-icon">
                  <Icon name={item.icon} size={14} />
                </span>
                {item.label}
              </span>
            </>
          ))
        }
      </div>

      <div class="hero-nav-group">
        {
          navRight.map((item, i) => (
            <>
              {i > 0 && (
                <span
                  class="hero-nav-sep"
                  data-tl-type="scroll"
                  data-tl-trigger="[data-hero]"
                  data-tl-start="0% top"
                  data-tl-end={`${i + 2}% top`}
                  data-tl-from="{'opacity':1,'y':0}"
                  data-tl-to="{'autoAlpha':0,'y':'1vw'}"
                  data-tl-desktop
                />
              )}
              {/* Ikon ikut dirender walau tak terlihat: kotak label harus
                  persis seukuran link sidebar, kalau tidak rasio lebarnya
                  bukan 1 dan navigasi ikut mengecil saat terbang ke hero. */}
              <span class="hero-nav-link" data-ghost-target={`nav-${item.id}`}>
                <span class="hero-nav-icon">
                  <Icon name={item.icon} size={14} />
                </span>
                {item.label}
              </span>
            </>
          ))
        }
      </div>
    </div>

    <h1
      class="hero-headline"
      data-tl-type="scroll"
      data-tl-trigger="[data-hero]"
      data-tl-start="5% top"
      data-tl-end="10% top"
      data-tl-from="{'opacity':1,'yPercent':0}"
      data-tl-to="{'yPercent':-100,'autoAlpha':0}"
      data-tl-desktop
    >
      {hero.headline.map((line) => <span class="hero-headline-line">{line}</span>)}
    </h1>

    <!-- Kartu hitungan compact di bawah headline — HANYA terlihat di mobile,
         sama seperti kartu tahun di atas potret. Lihat catatan pada kartu
         pertama soal kenapa tidak ada atribut `data-ghost*` di sini. -->
    {
      stats[0] && (
        <div class="hero-mobile-stat hero-mobile-stat-inline card">
          <span class="hero-mobile-stat-value">{stats[0].value}</span>
          <span class="hero-mobile-stat-label">{stats[0].label}</span>
        </div>
      )
    }

    <!-- Kartu traits tidak sekadar memudar: ia mengerut ke arah kiri-atas,
         seolah ditarik masuk ke rail. -->
    <div
      class="hero-traits glass-card"
      data-tl-type="scroll"
      data-tl-trigger="[data-hero]"
      data-tl-start="5% top"
      data-tl-end="20% top"
      data-tl-from="{'opacity':1,'scale':1,'x':0,'y':0}"
      data-tl-to="{'scale':0.3,'autoAlpha':0,'x':'-25vw','y':'-5vw'}"
      data-tl-desktop
    >
      {
        hero.traits.map((trait) => (
          <span class="hero-trait">
            <span class="hero-trait-mark" aria-hidden="true" />
            {trait}
          </span>
        ))
      }
    </div>

    <p
      class="hero-eyebrow"
      data-tl-type="scroll"
      data-tl-trigger="[data-hero]"
      data-tl-start="5% top"
      data-tl-end="10% top"
      data-tl-from="{'opacity':1,'yPercent':0}"
      data-tl-to="{'yPercent':-100,'autoAlpha':0}"
      data-tl-desktop
    >
      <span>{hero.eyebrow}</span>
      <span>{hero.eyebrowSecond}</span>
    </p>

    <a
      class="btn hero-secondary"
      href={hero.ctaSecondary.href}
      data-tl-type="scroll"
      data-tl-trigger="[data-hero]"
      data-tl-start="5% top"
      data-tl-end="12% top"
      data-tl-from="{'opacity':1}"
      data-tl-to="{'y':'2vw','autoAlpha':0}"
      data-tl-desktop
      data-button-hover
    >
      <span class="btn-label">{hero.ctaSecondary.label}</span>
    </a>
  </div>
</section>
