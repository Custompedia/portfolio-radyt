---
import { southeastAsia } from '../../data/site';
---

<section class="section southeast-asia" id="southeast-asia" aria-labelledby="southeast-asia-title">
  <div class="sea-copy">
    <span class="network-label">Next Direction</span>
    <h2 class="section-title h2-style" id="southeast-asia-title" data-reveal>{southeastAsia.headline}</h2>
    <p class="section-intro" data-reveal data-reveal-stagger="0.05">{southeastAsia.body}</p>
  </div>

  <div class="sea-map" aria-label="Peta posisi Semarang dan kawasan Asia Tenggara">
    <svg viewBox="0 0 760 520" role="img" aria-labelledby="sea-map-title sea-map-desc">
      <title id="sea-map-title">Semarang menuju Asia Tenggara</title>
      <desc id="sea-map-desc">Peta skematis Asia Tenggara dengan Semarang ditandai di Pulau Jawa.</desc>
      <g class="sea-land" aria-hidden="true">
        <path d="M130 44c38 11 63 35 82 72l24 70-28 56-45-29-11-65-39-54z" />
        <path d="M292 72l40 20 9 65-29 62-32-31 13-49-19-32z" />
        <path d="M382 104l64 5 43 41-14 63-63 24-38-42-4-53z" />
        <path d="M514 151l38 20 17 45-18 36-31-31 7-32z" />
        <path d="M204 302l154 9 72 13-30 19-142 4-68-19z" />
        <path d="M461 306l53-19 49 19-24 42-54 13-30-32z" />
        <path d="M591 254l50 24 19 50-26 46-28-27 10-44-35-23z" />
        <path d="M575 407l81 18 23 36-58 17-74-31z" />
      </g>
      <path class="sea-route" d="M334 334C362 280 425 244 524 218" aria-hidden="true" />
      <circle class="sea-pulse" cx="334" cy="334" r="12" aria-hidden="true" />
      <circle class="sea-target" cx="524" cy="218" r="16" aria-hidden="true" />
      <text class="sea-label sea-label--semarang" x="300" y="372">Semarang</text>
      <text class="sea-label sea-label--region" x="464" y="186">Southeast Asia</text>
    </svg>
  </div>
</section>
