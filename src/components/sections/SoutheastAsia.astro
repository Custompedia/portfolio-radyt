---
import { southeastAsia } from '../../data/site';
---

<section class="section southeast-asia" id="southeast-asia" data-sea-section aria-labelledby="southeast-asia-title">
  <div class="sea-container">
    <header class="section-head sea-head">
      <span class="sea-eyebrow">{southeastAsia.eyebrow}</span>
      <h2 class="section-title h2-style" id="southeast-asia-title">
        {southeastAsia.headline.map((line) => (
          <span class="sea-title-line">{line}</span>
        ))}
      </h2>
      <div class="sea-copy">
        <p class="sea-lead">{southeastAsia.body[0]}</p>
        <p class="sea-sublead">{southeastAsia.body[1]}</p>
      </div>
    </header>

    <div class="sea-stage" data-sea-stage>
      <div class="sea-frame">
        <!-- Tanpa `src`/`autoplay`: webm 2,7 MB baru terpilih tanpa src, dan pemutaran dipicu southeast-asia.ts saat section masuk layar. -->
        <video
          class="sea-video"
          data-sea-video
          loop
          muted
          playsinline
          webkit-playsinline
          x5-playsinline
          preload="metadata"
          poster="/video/sea-poster.webp"
        >
          <source src="/video/southeast-asia-zoom.webm" type="video/webm" />
          <source src="/video/southeast-asia-zoom.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>
