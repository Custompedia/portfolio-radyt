---
/**
 * Kartu kapabilitas TIDAK berdiri sebagai grid di bawah paragraf — mereka
 * ditanam di dalam paragrafnya, di celah yang ditandai `[chip]`. Di posisi itu
 * mereka mengerut jadi ikon saja; judul dan isinya baru muncul saat diklik,
 * lewat GSAP Flip yang memuaikannya jadi panel penuh layar.
 *
 * Alasan celahnya ditulis tangan di site.ts, bukan disebar otomatis: posisinya
 * bagian dari ritme kalimat. Menempatkannya tiap N kata membuat paragrafnya
 * terbaca seperti tabel.
 */
import Icon from '../Icon.astro';
import { capabilities } from '../../data/site';

const parts = capabilities.paragraph.split('[chip]');
---

<section class="section capabilities" id="capabilities">
  <!-- Judul raksasa dulu, pill label BARU di bawahnya. Urutan ini disengaja:
       di section lain pill selalu di atas judul. -->
  <header class="capabilities-head">
    <h2 class="capabilities-title h2-style" data-reveal>
      {capabilities.headline.map((line) => <span>{line}</span>)}
    </h2>
    <span class="label-pill" data-label-pill>{capabilities.label}</span>
  </header>

  <p class="capabilities-lead" data-capabilities-lead>
    {
      parts.map((part, i) => {
        const item = capabilities.items[i];
        // Spasi di sekitar `[chip]` di site.ts ada di KEDUA sisi penanda, jadi
        // kalau dirender apa adanya tiap chip diapit dua spasi. Jaraknya
        // diserahkan ke margin chip saja.
        const first = i === 0;
        const last = i === parts.length - 1;
        const text = first ? part.replace(/\s+$/, '') : last ? part.replace(/^\s+/, '') : part.trim();
        return (
          <>
            <span class="lead-text">{text}</span>
            {i < parts.length - 1 && item && (
              <button
                class="lead-chip"
                type="button"
                data-chip
                data-capa-title={item.title}
                data-capa-body={item.body}
                aria-label={`Selengkapnya: ${item.title}`}
              >
                <span class="lead-chip-icon">
                  <Icon name={item.icon} size={18} />
                </span>
                <span class="lead-chip-arrow" aria-hidden="true">
                  <Icon name="arrow" size={12} />
                </span>
              </button>
            )}
          </>
        );
      })
    }
  </p>
</section>

<!-- Sasaran Flip. Kosong sampai sebuah chip diklik: chip-nya diterbangkan ke
     sini lalu memuai jadi panel. -->
<div class="capa-overlay" data-capa-overlay hidden>
  <button class="capa-scrim" type="button" data-capa-close aria-label="Tutup"></button>
  <div class="capa-panel card" role="dialog" aria-modal="true" aria-labelledby="capa-title">
    <button class="capa-close" type="button" data-capa-close aria-label="Tutup">
      <Icon name="x" size={16} />
    </button>
    <span class="capa-panel-icon" data-capa-slot></span>
    <h3 class="capa-panel-title" id="capa-title" data-capa-title-out></h3>
    <p class="capa-panel-body" data-capa-body-out></p>
  </div>
</div>
