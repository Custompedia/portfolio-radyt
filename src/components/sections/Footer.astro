---
import Icon from '../Icon.astro';
import { brand, footer, hero } from '../../data/site';

const year = 2026;
---

<footer class="section site-footer">
  <div class="footer-main">
    <h2 class="footer-title" data-reveal>{footer.headline}</h2>
    <p class="footer-body" data-reveal data-reveal-stagger="0.05">{footer.body}</p>

    <div class="footer-actions">
      <a class="btn" href={brand.bookingUrl} target="_blank" rel="noopener noreferrer" data-button-hover data-magnetic>
        <span class="btn-label">{hero.ctaPrimary.label}</span>
      </a>
      <button class="btn btn-outline" type="button" data-copy={brand.email} data-button-hover data-magnetic>
        <span class="btn-label">{brand.email}</span>
      </button>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} {brand.name}{brand.symbol}</span>
    <nav class="footer-social" aria-label="Social">
      {
        brand.social.map((item) => (
          <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
            <Icon name={item.icon} size={14} />
          </a>
        ))
      }
    </nav>
  </div>
</footer>
