---
/**
 * FAQ tinggal di dalam `<footer>`, bukan sebagai section sendiri, dan halaman
 * berakhir di sini. Tidak ada blok footer terpisah: kontak, sosial, dan tombol
 * pemesanan semuanya sudah permanen di sidebar, jadi mengulanginya di kaki
 * halaman cuma menambah baris yang tidak dibaca siapa pun.
 *
 * Yang membuka footer justru wordmark raksasa — jawaban atas wordmark yang
 * membuka hero, dengan jejak gambar yang mengikuti kursor di atasnya.
 */
import Icon from '../Icon.astro';
import { brand, faq, work } from '../../data/site';

const trailPositions = ['0% 0%', '50% 0%', '100% 0%', '0% 100%', '50% 100%', '100% 100%'];
const trailTiles = work.items.map(({ title, kind, accent }, index) => ({ title, kind, accent, position: trailPositions[index % trailPositions.length] }));
---

<footer class="site-footer" id="faq">
  <!-- Wordmark penutup. Jejaknya digambar di atas elemen ini oleh
       modules/image-trail.ts. -->
  <div class="footer-wordmark-wrap" data-trail-area>
    <p class="footer-wordmark" aria-label={brand.name}>
      <span aria-hidden="true">{brand.name}</span><span class="footer-wordmark-symbol" aria-hidden="true"
        >{brand.symbol}</span
      >
    </p>
    <div class="trail-layer" data-trail-layer aria-hidden="true">
      {
        trailTiles.map((tile) => (
          <span class="trail-tile" data-trail-tile style={`--tile:${tile.accent};--tile-position:${tile.position}`}>
            <span class="trail-tile-label">
              <strong>{tile.title}</strong>
              <small>{tile.kind}</small>
            </span>
          </span>
        ))
      }
      <span class="trail-ripple" data-trail-ripple></span>
    </div>
  </div>

  <header class="section-head faq-head">
    <span class="label-pill" data-label-pill>{faq.label}</span>
    <h2 class="section-title h2-style" data-reveal>
      {faq.headline.map((line) => <span>{line}</span>)}
    </h2>
    <p class="faq-intro" data-reveal>{faq.intro}</p>
  </header>

  <div class="faq-groups">
    {
      faq.groups.map((group) => (
        <section class="faq-group" aria-labelledby={`faq-${group.title.replaceAll(' ', '-').toLowerCase()}`}>
          <h3 id={`faq-${group.title.replaceAll(' ', '-').toLowerCase()}`}>{group.title}</h3>
          <div class="faq-prompts">
            {group.items.map((item) => (
              <button
                class="faq-prompt"
                type="button"
                data-contact-prompt
                data-contact-title={item.question}
                data-contact-message={item.message}
              >
                <span>{item.question}</span>
                <Icon name="arrow" size={18} />
              </button>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <dialog class="contact-dialog" data-contact-dialog data-contact-whatsapp={brand.bookingUrl} aria-labelledby="contact-dialog-title">
    <div class="contact-dialog-panel">
      <form method="dialog">
        <button class="contact-dialog-close" type="submit" aria-label="Tutup"><Icon name="x" size={18} /></button>
      </form>
      <span class="contact-dialog-label">Pesan untuk Mas Radhyta</span>
      <h3 id="contact-dialog-title" data-contact-title></h3>
      <label class="contact-dialog-message" for="contact-message">
        <span>Edit jika diperlukan</span>
        <textarea id="contact-message" rows="6" data-contact-message></textarea>
      </label>
      <a class="btn contact-dialog-send" href={brand.bookingUrl} target="_blank" rel="noopener noreferrer" data-contact-send>
        <span class="btn-label">Kirim ke WhatsApp</span>
        <Icon name="arrow" size={17} />
      </a>
    </div>
  </dialog>
</footer>
