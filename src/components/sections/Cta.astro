---
import { brand, cta } from '../../data/site';
---

<section class="packaging-test theme-dark" data-packaging-test data-theme-section data-theme-duration="4.1" aria-labelledby="packaging-test-title">
  <div class="packaging-test-stage">
    <header class="packaging-test-copy">
      <span class="packaging-test-label" data-packaging-intro>{cta.label}</span>
      <h2 id="packaging-test-title" class="packaging-test-title">
        {cta.headline.map((line) => <span data-packaging-intro>{line}</span>)}
      </h2>
      <p class="packaging-test-intro" data-packaging-intro>{cta.intro}</p>
    </header>

    <div class="packaging-test-scene" aria-hidden="true">
      <span class="packaging-arrival-line" data-packaging-arrival></span>
      <span class="packaging-scene-label" data-packaging-detail>MADE TO BE REMEMBERED</span>
      <div class="packaging-box" data-packaging-box>
        <div class="packaging-box-spin" data-packaging-spin>
          <div class="packaging-box-face packaging-box-front">
            <div class="packaging-box-meta"><span>PARCELIN CUSTOM PACK</span><span>EDITION 01</span></div>
            <div class="packaging-box-cover">
              <div class="packaging-box-brand">
                <img class="packaging-box-logo" src="/images/favicon.svg" alt="" />
                <span>CUSTOMPEDIA</span>
              </div>
              <span class="packaging-box-divider" aria-hidden="true"></span>
              <img class="packaging-box-artwork" src="/images/Parcelinpack-transparent.webp" alt="" />
            </div>
            <span class="packaging-box-footer">PACKAGING, MADE PERSONAL.</span>
          </div>
          <div class="packaging-box-face packaging-box-back">
            <div class="packaging-box-back-copy"><span>CUSTOM</span><span>PACK</span><span>STUDIO</span></div>
            <img class="packaging-box-back-logo" src="/images/favicon.svg" alt="" />
            <span class="packaging-box-back-note">MADE FOR THE MOMENT IT ARRIVES</span>
          </div>
          <span class="packaging-box-face packaging-box-right"></span>
          <span class="packaging-box-face packaging-box-left"></span>
          <span class="packaging-box-face packaging-box-top"></span>
          <span class="packaging-box-face packaging-box-bottom"></span>
        </div>
      </div>
      <span class="packaging-test-shadow" data-packaging-shadow></span>
      <span class="packaging-scene-ring packaging-scene-ring-one" data-packaging-detail></span>
      <span class="packaging-scene-ring packaging-scene-ring-two" data-packaging-detail></span>
    </div>

    <ol class="packaging-test-moments" data-packaging-moments>
      {
        cta.moments.map((moment) => (
          <li class="packaging-test-moment">
            <span class="packaging-test-number">{moment.number}</span>
            <span class="packaging-test-moment-copy">
              <strong>{moment.label}</strong>
              <span>{moment.question}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <div class="packaging-test-outro" data-packaging-outro>
      <p>{cta.closing.map((line) => <span>{line}</span>)}</p>
      <a class="btn packaging-test-button" href={brand.bookingUrl} target="_blank" rel="noopener noreferrer" data-button-hover>
        <span class="btn-label">{cta.action}</span>
      </a>
    </div>
  </div>
</section>
