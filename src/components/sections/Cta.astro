---
/**
 * Judul empat baris dengan dua baris terakhir dipudarkan, lalu simulasi
 * percakapan: avatar → titik-titik mengetik → gelembung pertanyaan → tombol.
 *
 * Rotator kata yang sebelumnya ada di sini dihapus. Ia menarik perhatian ke
 * satu kata yang berganti-ganti, sementara section ini justru harus mengarahkan
 * perhatian ke tombolnya.
 */
import { brand, cta } from '../../data/site';
---

<section class="section cta" data-cta>
  <h2 class="cta-title">
    {cta.headline.map((line) => <span class="cta-line" data-reveal>{line}</span>)}
    {cta.headlineSoft.map((line) => <span class="cta-line cta-line--soft" data-reveal>{line}</span>)}
  </h2>

  <div class="cta-body">
    <p class="cta-lead" data-reveal data-reveal-stagger="0.05">{cta.body}</p>

    <!-- Urutannya dijalankan cta-chat.ts saat masuk viewport: titik-titik
         berkedip dulu, baru gelembungnya menggantikan mereka, baru tombolnya. -->
    <div class="cta-chat" data-cta-chat>
      <span class="cta-chat-avatar" aria-hidden="true"></span>

      <div class="cta-chat-stack">
        <span class="cta-chat-typing" data-cta-typing aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>

        <span class="cta-chat-bubble" data-cta-bubble>{cta.chat}</span>
      </div>

      <a
        class="btn cta-button"
        href={brand.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-cta-button
        data-button-hover
      >
        <span class="btn-label">{cta.chatCta}</span>
      </a>
    </div>
  </div>
</section>
