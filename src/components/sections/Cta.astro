---
import Icon from '../Icon.astro';
import { brand, cta } from '../../data/site';
---

<section class="section cta" data-cta>
  <h2 class="cta-title">
    {cta.headline.map((line) => <span class="cta-line" data-reveal>{line}</span>)}
    <!-- Kata terakhir berganti-ganti: satu kolom kata yang digeser per baris. -->
    <span class="cta-rotator" data-cta-rotator aria-label={cta.accent}>
      <span class="cta-rotator-track" data-cta-rotator-track>
        {cta.rotating.map((word) => <span class="cta-rotator-word">{word}</span>)}
      </span>
    </span>
  </h2>

  <div class="cta-body">
    <p class="cta-lead" data-reveal data-reveal-stagger="0.05">{cta.body}</p>
    <ul class="cta-points">
      {
        cta.points.map((point) => (
          <li
            data-tl-from="{'opacity':0,'x':-20}"
            data-tl-to="{'opacity':1,'x':0,'duration':0.6}"
            data-tl-start="top 90%"
            data-tl-once
          >
            <Icon name="check" size={15} />
            {point}
          </li>
        ))
      }
    </ul>
    <a
      class="btn cta-button"
      href={brand.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-button-hover
      data-magnetic
    >
      <span class="btn-label">Minta Audit Gratis</span>
    </a>
  </div>
</section>
