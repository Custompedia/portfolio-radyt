---
/**
 * Section 02 — About.
 *
 * Sisi personal Radhyta. Konten memakai sudut pandang orang pertama agar
 * halaman ini terasa sebagai portfolio founder, bukan profil korporat.
 */
import { about } from '../../data/site';
---

<section class="section about" id="about">
  <header class="section-head about-head">
    <h2 class="section-title h2-style" data-reveal>{about.headline}</h2>
  </header>

  <div class="about-portrait" data-about-profile>
    <div class="about-copy">
      <p class="about-intro" data-reveal data-reveal-stagger="0.035">{about.intro}</p>
      <p class="about-statement" data-reveal data-reveal-stagger="0.035">{about.statement}</p>
    </div>
    <figure class="about-desk">
      <img
        src="/images/about/radhyta-desk.png"
        alt="Meja kerja dengan materi proses kreatif, kemasan, dan catatan proyek"
        width="1672"
        height="941"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>

  <div class="about-facts" data-about-stories>
    {
      about.facts.map((fact) => (
        <article class="about-fact" data-about-story>
          <strong>{fact.value}</strong>
          <p>{fact.label}</p>
        </article>
      ))
    }
  </div>
</section>
