---
/**
 * Section 02 — About.
 *
 * Sisi personal dan cerita perintis dilebur ke sini; keduanya tidak lagi punya
 * section sendiri. Empat paragrafnya berurutan dan tidak boleh ditukar: tiga
 * perusahaan → mental perintis → masa pandemi → di luar bisnis.
 *
 * Section inilah yang ditarik naik menimpa hero (`.about` di sections.css),
 * jadi ia harus tetap section pertama sesudah Hero.
 */
import { about } from '../../data/site';

/** Kelas per logo dipakai untuk menyeimbangkan ukuran optis — tiga kanvas
 *  logonya punya rasio ruang kosong yang berbeda-beda. */
const slug = (name: string): string => name.toLowerCase();
---

<section class="section about" id="about">
  <header class="section-head about-head">
    <span class="label-pill" data-label-pill>{about.eyebrow}</span>
    <div class="about-title-row">
      <h2 class="section-title h2-style" data-reveal>{about.headline}</h2>
      <div class="about-brands" aria-label="Tiga perusahaan Radhyta">
        {
          about.logos.map((logo) => (
            <img
              class:list={['about-brand', `about-brand--${slug(logo.name)}`]}
              src={logo.src}
              alt={logo.name}
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>
    </div>
  </header>

  <div class="about-body">
    {about.paragraphs.map((paragraph) => <p data-reveal data-reveal-stagger="0.04">{paragraph}</p>)}
  </div>
</section>
