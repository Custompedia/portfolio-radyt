---
/**
 * Section 02 — About.
 *
 * Cerita ringkas tentang Radhyta dan bisnis yang dibangunnya.
 */
import { about } from '../../data/site';
---

<section class="section about" id="about">
  <header class="section-head about-head">
    <h2 class="section-title h2-style" data-reveal>{about.headline}</h2>
  </header>

  <div class="about-story" data-about-profile>
    <p class="about-lead" data-reveal data-reveal-stagger="0.035">{about.lead}</p>
    <div class="about-year" data-about-mark aria-label={about.since}>
      <span>{about.since}</span>
      <strong>2014</strong>
    </div>
  </div>

  <div class="about-detail" data-about-stories>
    <p data-about-story>{about.body}</p>
    <span data-about-story>{about.location}</span>
  </div>
</section>
