---
/**
 * Section 05 — Network & Reach. Tiga bagian berurutan:
 *
 *   1. Active in    — komunitas bisnis, ditulis satu baris dipisah titik tengah
 *   2. Trusted by   — logo klien (dibaca dari `clients`, sumber yang sama
 *                     dengan marquee sidebar supaya keduanya tidak pernah beda)
 *   3. Outlook      — ASPIRASI ke Asia Tenggara, bukan pencapaian
 *
 * Bagian 3 sengaja tidak punya peta dan tidak menyebut negara: belum ada klien
 * di sana, dan menaruhnya di peta akan terbaca sebagai jangkauan yang sudah
 * berjalan.
 */
import { clients, companies, network } from '../../data/site';
---

<section class="section network" id="network">
  <header class="section-head network-head">
    <span class="label-pill" data-label-pill>{network.eyebrow}</span>
    <h2 class="section-title h2-style" data-reveal>{network.headline}</h2>
    <p class="section-intro" data-reveal data-reveal-stagger="0.05">{network.intro}</p>
  </header>

  <div class="network-body">
    <section class="network-block" aria-labelledby="network-active">
      <h3 class="network-label" id="network-active">{network.activeLabel}</h3>
      <ul class="network-company-logos">
        {
          companies.items.map((company) => (
            <li class="network-company-logo" data-network-logo>
              <img src={company.logo} alt={company.name} loading="lazy" decoding="async" />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="network-block" aria-labelledby="network-trusted">
      <h3 class="network-label" id="network-trusted">{network.trustedLabel}</h3>
      <ul class="network-logos">
        {
          clients.map((client) => (
            <li
              class:list={['network-logo', `network-logo--${client.shape}`]}
              data-network-logo
              style={`--logo-width-desktop:${client.desktopWidth * 1.6}vw;--logo-width-mobile:${client.mobileWidth * 1.4}px;--logo-scale:${client.scale ?? 1}`}
            >
              <img src={client.src} alt={client.name} loading="lazy" decoding="async" />
            </li>
          ))
        }
      </ul>
    </section>

  </div>
</section>
