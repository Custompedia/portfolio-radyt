---
/**
 * Section 05 - Network & Reach. Tiga bagian berurutan:
 *
 *   1. Active in    - komunitas bisnis dengan logo atau monogram yang jelas
 *   2. Trusted by   - logo klien (dibaca dari `clients`, sumber yang sama
 *                     dengan marquee sidebar supaya keduanya tidak pernah beda)
 *   3. Outlook dipisah menjadi section Southeast Asia tersendiri.
 *
 * Bagian 3 sengaja tidak punya peta dan tidak menyebut negara: belum ada klien
 * di sana, dan menaruhnya di peta akan terbaca sebagai jangkauan yang sudah
 * berjalan.
 */
import { clients, network, networkActive } from '../../data/site';
---

<section class="section network" id="network">
  <header class="section-head network-head">
    <h2 class="section-title h2-style" data-reveal>{network.headline}</h2>
    <p class="section-intro" data-reveal data-reveal-stagger="0.05">{network.intro}</p>
  </header>

  <div class="network-body">
    <section class="network-block" aria-labelledby="network-active">
      <h3 class="network-label" id="network-active">{network.activeLabel}</h3>
      <ul class="network-constellation network-constellation--active">
        {
          networkActive.map((member) => (
            <li class:list={['network-orbit', `network-orbit--${member.shape ?? 'mark'}`]} data-network-active>
              <div class="network-orbit-mark">
                <img src={member.src} alt={`Logo ${member.name}`} loading="lazy" decoding="async" />
              </div>
              <span class="network-orbit-name">{member.name}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="network-block network-block--trusted" aria-labelledby="network-trusted">
      <h3 class="network-label" id="network-trusted">{network.trustedLabel}</h3>
      <div class="trusted-marquees" aria-label="Daftar klien yang mempercayai Radhyta">
        {[clients.slice(0, 10), clients.slice(10)].map((row, rowIndex) => (
          <div class:list={['trusted-marquee', rowIndex === 1 && 'trusted-marquee--reverse']}>
            <ul class="trusted-marquee-track">
              {[...row, ...row].map((client, index) => (
                <li class="trusted-logo" aria-hidden={index >= row.length ? 'true' : undefined}>
                  <img src={client.src} alt={index < row.length ? client.name : ''} loading="lazy" decoding="async" />
                  {index < row.length && <span>{client.name}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</section>
