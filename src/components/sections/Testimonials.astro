---
import Icon from '../Icon.astro';
import { testimonials } from '../../data/site';
---

<section class="section testimonials" id="clients">
  <header class="section-head testimonials-head">
    <div>
      <span class="label-pill" data-label-pill>{testimonials.label}</span>
      <h2 class="section-title h2-style" data-reveal>
        {testimonials.headline.map((line) => <span>{line}</span>)}
      </h2>
    </div>

    <!-- Pagination custom: satu ruas per slide, ruas aktif memanjang & menguning. -->
    <div class="testimonial-progress" data-testimonial-progress aria-hidden="true">
      {testimonials.items.map(() => <span class="testimonial-progress-bar" />)}
    </div>
  </header>

  <div class="swiper testimonial-swiper" data-testimonial-swiper>
    <div class="swiper-wrapper">
      {
        testimonials.items.map((item) => (
          <article class="swiper-slide testimonial-card card">
            <div class="testimonial-top">
              <h3 class="testimonial-headline">{item.headline}</h3>
              <span class="testimonial-quote-mark" aria-hidden="true">
                <Icon name="quote" size={16} />
              </span>
            </div>
            <p class="testimonial-quote">{item.quote}</p>
            <footer class="testimonial-author">
              <span class="testimonial-avatar" aria-hidden="true" />
              <span>
                <strong>{item.name}</strong>
                <span class="testimonial-role">{item.role}</span>
                <span class="testimonial-company">{item.company}</span>
              </span>
            </footer>
          </article>
        ))
      }
    </div>
  </div>

  <span class="testimonial-drag" data-testimonial-drag aria-hidden="true">
    <span class="testimonial-drag-mask">
      <span class="testimonial-drag-track">
        <span>Geser</span>
        <span>Tahan</span>
      </span>
    </span>
  </span>
</section>
