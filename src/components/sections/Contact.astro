---
/**
 * Section 07 — footer sungguhan, sekaligus CTA penutup. Halaman berakhir di sini.
 *
 * Susunannya tiga lapis, dari yang paling mengajak ke yang paling administratif:
 *
 *   1. CTA   — "Let's talk.", satu kalimat, dan satu tombol WhatsApp.
 *   2. Kolom — menu, ventures, kontak, sosial. Ini yang sebelumnya tidak ada:
 *              separuh kanan footer kosong melompong sementara semua tautan
 *              situs cuma hidup di rail kiri, yang justru menghilang di layar
 *              sempit.
 *
 * Halaman berhenti di kolom itu. Baris penutup (wordmark + hak cipta + "kembali
 * ke atas") sempat ada dan DIHAPUS atas permintaan: setinggi apa pun isinya, ia
 * selalu jatuh di bawah lipatan sebagai satu strip tipis yang terbaca terpisah
 * dari footernya sendiri.
 *
 * Tombol "Chat on WhatsApp" di sini adalah satu-satunya CTA di layar saat section
 * ini terlihat: tombol WhatsApp di rail disembunyikan oleh `html.at-contact`
 * (lihat modules/nav-active.ts), kalau tidak ada dua tombol WhatsApp bersamaan.
 *
 * Isi kolomnya diambil dari sumber yang sudah ada — `nav`, `hero.traits`,
 * `social`, `brand` — supaya menambah menu atau venture tidak perlu menyentuh
 * berkas ini sama sekali.
 */
import Icon from '../Icon.astro';
import { brand, contact, hero, nav, social } from '../../data/site';
---

<footer class="site-footer" id="contact">
  <div class="footer-shell">
    <div class="footer-cta">
      <h2 class="footer-headline h2-style" data-footer-reveal>{contact.headline}</h2>
      <div class="footer-cta-row" data-footer-reveal>
        <p class="footer-lead">{contact.body}</p>
        <a class="footer-wa" href={contact.button.href} target="_blank" rel="noopener noreferrer">
          <span class="footer-wa-icon"><Icon name="whatsapp" size={20} /></span>
          <span class="footer-wa-label">{contact.button.label}</span>
          <Icon name="arrow" size={17} class="footer-wa-arrow" />
        </a>
      </div>
    </div>

    <div class="footer-cols" data-footer-reveal>
      <nav class="footer-col" aria-label="Navigasi footer">
        <h3 class="footer-col-title">Menu</h3>
        <ul class="footer-list">
          {
            nav.map((item) => (
              <li>
                <a class="footer-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col">
        <h3 class="footer-col-title">Ventures</h3>
        <ul class="footer-list">
          {
            hero.traits.map((venture) => (
              <li>
                <span class="footer-static">{venture}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-title">Kontak</h3>
        <ul class="footer-list">
          <li><a class="footer-link" href={`mailto:${brand.email}`}>{brand.email}</a></li>
          <li>
            <a class="footer-link" href={brand.whatsappUrl} target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
          </li>
          <li><span class="footer-static">Semarang, Indonesia</span></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-title">Sosial</h3>
        <ul class="footer-social">
          {
            social.map((channel) => (
              <li>
                <a
                  class="footer-social-link"
                  href={channel.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={channel.label}
                >
                  <Icon name={channel.icon} size={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

  </div>
</footer>
