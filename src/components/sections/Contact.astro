---
import Icon from '../Icon.astro';
import { brand, contact, nav, social, ventures } from '../../data/site';
---

<footer class="site-footer" id="contact">
  <div class="footer-shell">
    <div class="footer-cta" data-footer-reveal>
      <h2 class="footer-headline">Let's Talk!</h2>
      <div class="footer-lead-wrap">
        <p class="footer-lead">
          Tertarik untuk berdiskusi lebih lanjut atau membangun koneksi?<br />
          Hubungi saya.
        </p>
      </div>
      <div class="footer-actions">
        <a class="footer-wa-btn" href={contact.button.href} target="_blank" rel="noopener noreferrer">
          <span class="footer-wa-badge"><Icon name="whatsapp" size={18} /></span>
          <span class="footer-wa-text">Chat on WhatsApp</span>
          <Icon name="arrow" size={16} class="footer-wa-arrow" />
        </a>
        <ul class="footer-social-row" aria-label="Media sosial Radhyta">
          {social.map((channel) => (
            <li>
              <a
                class="footer-social-pill"
                href={channel.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={channel.label}
              >
                <Icon name={channel.icon} size={18} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-cols" data-footer-reveal>
      <nav class="footer-col" aria-label="Navigasi footer">
        <h3 class="footer-col-title">MENU</h3>
        <ul class="footer-list">
          {nav.map((item) => (
            <li>
              <a class="footer-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-col">
        <h3 class="footer-col-title">VENTURES</h3>
        <ul class="footer-list">
          {ventures.map((venture) => (
            <li>
              <a class="footer-link" href={venture.href} target="_blank" rel="noopener noreferrer">
                {venture.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col footer-col--contact">
        <h3 class="footer-col-title">KONTAK</h3>
        <ul class="footer-list">
          <li><a class="footer-link" href={`mailto:${brand.email}`}>{brand.email}</a></li>
          <li>
            <a class="footer-link" href={brand.whatsappUrl} target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
          </li>
          <li>
            <a class="footer-link" href={contact.location.href} target="_blank" rel="noopener noreferrer">
              {contact.location.label}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
