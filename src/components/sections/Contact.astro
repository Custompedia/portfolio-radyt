---
/**
 * Section 07 — CTA penutup, sekaligus footer. Halaman berakhir di sini.
 *
 * Menggantikan QnA picker lama ("Ada yang ingin kamu sampaikan?", dua kolom,
 * delapan opsi, dan dialog pesan siap kirim) dengan satu blok bersih: eyebrow,
 * headline, body, SATU tombol, dan baris kontak alternatif. Picker itu tidak
 * pindah ke section lain — ia dihapus.
 *
 * Footer dibuka dengan “Let's talk.” sebagai headline terbesar; wordmark kini
 * menjadi detail penutup, bukan prioritas visual.
 *
 * Tombol "Chat on WhatsApp" di sini adalah satu-satunya CTA di layar saat
 * section ini terlihat: tombol WhatsApp di rail disembunyikan oleh
 * `html.at-contact` (lihat modules/nav-active.ts), kalau tidak ada dua tombol
 * WhatsApp bersamaan.
 */
import Icon from '../Icon.astro';
import { brand, contact, work } from '../../data/site';

const trailPositions = ['0% 0%', '50% 0%', '100% 0%', '0% 100%', '50% 100%', '100% 100%'];
const trailTiles = work.items.map(({ title, kind, accent }, index) => ({ title, kind, accent, position: trailPositions[index % trailPositions.length] }));
---

<footer class="site-footer" id="contact">
  <!-- Wordmark penutup. Jejaknya digambar di atas elemen ini oleh
       modules/image-trail.ts. -->
  <div class="footer-wordmark-wrap" data-trail-area>
    <p class="footer-wordmark" aria-hidden="true">{brand.name}{brand.symbol}</p>
    <div class="trail-layer" data-trail-layer aria-hidden="true">
      {
        trailTiles.map((tile) => (
          <span class="trail-tile" data-trail-tile style={`--tile:${tile.accent};--tile-position:${tile.position}`}>
            <span class="trail-tile-label">
              <strong>{tile.title}</strong>
              <small>{tile.kind}</small>
            </span>
          </span>
        ))
      }
      <span class="trail-ripple" data-trail-ripple></span>
    </div>
  </div>

  <div class="contact-block">
    <span class="label-pill" data-label-pill>{contact.eyebrow}</span>
    <h2 class="contact-headline h2-style" data-reveal>{contact.headline}</h2>
    <p class="contact-body" data-reveal data-reveal-stagger="0.05">{contact.body}</p>

    <a
      class="btn btn-primary contact-button"
      href={contact.button.href}
      target="_blank"
      rel="noopener noreferrer"
      data-button-hover
    >
      <span class="btn-label">{contact.button.label}</span>
    </a>

    <ul class="contact-alt">
      {
        contact.alt.map((channel) => (
          <li>
            <a
              href={channel.href}
              target={channel.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={channel.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            >
              <Icon name={channel.icon} size={18} />
              <span>{channel.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
