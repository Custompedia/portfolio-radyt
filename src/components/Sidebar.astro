---
/**
 * Sidebar memegang elemen ASLI. Di hero ada placeholder kosong dengan
 * `data-ghost-target` yang senama; ghost.ts mengukur selisih posisi keduanya
 * lalu menerbangkan elemen ini dari posisi hero ke posisi sidebar saat scroll.
 *
 * ATURAN: elemen ber-`data-ghost` TIDAK BOLEH mengandung elemen ber-`data-ghost`
 * lain — transform-nya akan bertumpuk dan pengukurannya jadi salah. Karena itu
 * tiap kartu dipecah jadi lapisan background sendiri (`.nav-card-bg`) plus
 * anak-anak yang jadi saudara, bukan keturunan.
 */
import Icon from './Icon.astro';
import { brand, hero, nav, stats, clients } from '../data/site';
---

<aside id="mobile-navigation" class="sidebar" data-sidebar>
  <div class="nav-card nav-top">
    <span class="nav-card-bg" data-ghost-fade></span>
    <!-- Pill ini adalah TITIK MENDARAT wordmark raksasa. Jendelanya 36.7%–40%
         (= 110vh–120vh dari puncak hero) sengaja berakhir persis di ujung
         morph: saat pill mencapai opacity penuh, wordmark yang mengerut sudah
         berimpit di atasnya dan tinggal padam. Kalau jendelanya dimulai
         setelah morph selesai (versi lama: 40%–44%), ada satu jeda di mana
         pojok kiri atas benar-benar kosong.
         `data-brand-name` dibaca ghost.ts sebagai kotak tujuan. -->
    <a
      class="brand"
      href="#home"
      data-tl-type="scroll"
      data-tl-trigger="[data-hero]"
      data-tl-start="36.7% top"
      data-tl-end="40% top"
      data-tl-from="{'autoAlpha':0}"
      data-tl-to="{'autoAlpha':1}"
      data-tl-desktop
    >
      <span class="brand-name" data-brand-name>{brand.name}</span><span class="brand-symbol">{brand.symbol}</span>
    </a>
    <div class="social" data-ghost-fade>
      {
        brand.social.map((item) => (
          <a class="social-link" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
            <Icon name={item.icon} size={13} />
          </a>
        ))
      }
    </div>
    <p class="nav-tagline" data-ghost="tagline" data-ghost-type="box">{brand.tagline}</p>
  </div>

  <!-- Panel yang bisa dibuka/tutup di mobile (lihat mobile-menu.ts): brand +
       tagline di atas dan tombol CTA di bawah SENGAJA di LUAR wrapper ini
       (lihat komponen sebelum & sesudah blok ini) supaya keduanya tetap
       terlihat sebagai topbar tetap terlepas dari status buka/tutup panel.
       Di desktop wrapper ini `display:contents` — tidak mengubah apa pun,
       anak-anaknya tetap ikut flex/gap milik `.sidebar` seperti sebelumnya. -->
  <div class="sidebar-panel" data-sidebar-panel>
    <!-- Tiap statistik jadi kartu terpisah, bukan satu kartu dengan pemisah: di
         hero masing-masing terbang dari posisi berbeda, jadi butuh lapisan bg
         sendiri. Kalau statistiknya lebih dari satu, gap-nya nol dan sisi yang
         bertemu kehilangan radius sehingga terbaca sebagai satu kartu dengan
         garis pemisah di tengah. -->
    <div class="nav-stats-row">
      {
        stats.map((stat, i) => (
          <div class="nav-card nav-stat-card">
            <span class="nav-card-bg" data-ghost={`stats-card-${i}`} data-ghost-type="background" />
            {/* Di rail keduanya BERTUMPUK (angka di atas, label di bawah).
                Kartu pertama tampil BERDAMPINGAN saat masih berukuran hero, dan
                itu yang ditandai `data-ghost-alt`: ghost.ts mengukur susunan
                bernama kelas itu satu frame, lalu menirunya dengan menggeser
                kedua anaknya memakai transform sepanjang morph. Kartu kedua
                tanpa atribut itu — susunannya sama di kedua tempat, jadi cukup
                digeser dan diskalakan seperti ghost `box` biasa. */}
            <div
              class="nav-stat"
              data-ghost={`stat-${i}`}
              data-ghost-type="box"
              data-ghost-alt={i === 0 ? 'is-inline' : undefined}
            >
              <span class="nav-stat-value">{stat.value}</span>
              <span class="nav-stat-label">
                {
                  stat.label.split(' ').map((word) => (
                    <span class="nav-stat-label-word">{word}</span>
                  ))
                }
              </span>
            </div>
          </div>
        ))
      }
      {
        stats.length > 1 && (
          <span
            class="nav-stats-sep"
            aria-hidden="true"
            data-tl-type="scroll"
            data-tl-trigger="[data-hero]"
            data-tl-start="39% top"
            data-tl-end="41% top"
            data-tl-from="{'opacity':0}"
            data-tl-to="{'opacity':0.18}"
            data-tl-desktop
          />
        )
      }
    </div>

    <nav class="nav-card nav-menu" aria-label="Primary">
      <span class="nav-card-bg" data-ghost-fade></span>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                class="nav-link"
                href={item.href}
                data-nav-link={item.id}
                data-ghost={`nav-${item.id}`}
                data-ghost-type="box"
              >
                <span class="nav-link-bg" aria-hidden="true"></span>
                <span class="nav-link-icon">
                  <Icon name={item.icon} size={14} />
                </span>
                <span class="nav-link-label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-card nav-clients">
      <span class="nav-card-bg" data-ghost-fade></span>
      <div class="marquee" data-ghost-fade>
        <div class="marquee-track">
          <div class="marquee-group">
            {
              clients.map((client) => (
                <span
                  class:list={['marquee-item', `marquee-item--${client.shape}`]}
                  style={`--logo-width-desktop:${client.desktopWidth}vw;--logo-width-mobile:${client.mobileWidth}px;--logo-scale:${client.scale ?? 1}`}
                >
                  <img class="marquee-logo" src={client.src} alt={client.name} loading="eager" decoding="async" />
                </span>
              ))
            }
          </div>
          <div class="marquee-group" aria-hidden="true">
            {
              clients.map((client) => (
                <span
                  class:list={['marquee-item', `marquee-item--${client.shape}`]}
                  style={`--logo-width-desktop:${client.desktopWidth}vw;--logo-width-mobile:${client.mobileWidth}px;--logo-scale:${client.scale ?? 1}`}
                >
                  <img class="marquee-logo" src={client.src} alt="" loading="eager" decoding="async" />
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="nav-card nav-email">
      <span class="nav-card-bg" data-ghost-fade></span>
      <button class="nav-email-btn" type="button" data-copy={brand.email} data-ghost-fade>
        <span class="nav-email-text">{brand.email}</span>
        <span class="nav-email-icon">
          <Icon name="copy" size={14} />
        </span>
        <span class="nav-email-done" aria-live="polite"></span>
      </button>
    </div>
  </div>

  <a
    class="btn btn-primary"
    href={hero.ctaPrimary.href}
    target="_blank"
    rel="noopener noreferrer"
    data-ghost="cta-primary"
    data-ghost-type="size"
    data-button-hover
  >
    <span class="btn-label">{hero.ctaPrimary.label}</span>
  </a>
</aside>

<button
  class="mobile-menu-trigger"
  type="button"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="mobile-navigation"
  data-menu-trigger
>
  <span class="mobile-menu-trigger-label" aria-hidden="true">
    <span class="mobile-menu-trigger-label-menu">Menu</span>
    <span class="mobile-menu-trigger-label-close">Close</span>
  </span>
  <span class="mobile-menu-trigger-icon" aria-hidden="true">
    <span></span>
    <span></span>
  </span>
</button>
