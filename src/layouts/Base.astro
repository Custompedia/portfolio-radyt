---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/sections.css';
import { brand, companies, hero } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${brand.role} — ${brand.person} | ${brand.name}${brand.symbol}`,
  description = hero.subheadline,
} = Astro.props;
const socialImage = new URL('/images/radyta-og-blue.jpg', Astro.url).href;
---

<!-- lang="id": seluruh isi situs berbahasa Indonesia. Salah menandainya
     membuat pembaca layar melafalkannya dengan fonem Inggris. -->
<!doctype html>
<html lang="id" class="js-loading">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Radyta creative agency portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Radyta creative agency portfolio" />
    <meta name="theme-color" content="#d5cfbe" />
    <link rel="canonical" href={Astro.site} />

    <!-- Favicon SVG inline: pill biru dengan inisial, kembaran pill brand di
         sidebar. Hurufnya PUTIH, bukan hitam seperti versi kuning — hitam di
         atas #112BD6 cuma 2.3:1. Tanpa ini browser meminta /favicon.ico dan
         dapat 404. -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23112bd6'/%3E%3Ctext x='16' y='23' font-family='Helvetica,Arial,sans-serif' font-size='20' font-weight='700' text-anchor='middle' fill='%23fff'%3ER%3C/text%3E%3C/svg%3E"
    />

    <link rel="preload" href="/fonts/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-900.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Logo tiga perusahaan. Sebelumnya `loading="lazy"` tanpa preload: browser
         baru meminta berkasnya ketika grid hampir masuk layar, sementara animasi
         singkapnya sudah jalan duluan — jadi kotaknya kosong dulu, logonya
         menyusul. Prioritasnya SENGAJA rendah: ketiganya jauh di bawah lipatan
         dan tidak boleh berebut antrean dengan potret hero maupun font.
         Diturunkan dari data, bukan ditulis ulang — menambah perusahaan tidak
         perlu menyentuh berkas ini. -->
    {companies.items.map((company) => <link rel="preload" href={company.logo} as="image" fetchpriority="low" />)}

    <!-- Harus inline dan di <head>: GhostEngine hanya bisa mengukur posisi awal
         saat scroll benar-benar nol. Modul yang di-defer sudah terlambat —
         browser keburu memulihkan posisi scroll sebelumnya. -->
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      addEventListener('beforeunload', () => window.scrollTo(0, 0));
    </script>
  </head>
  <body>
    <slot />

    <!-- Butir film di atas SELURUH halaman, satu elemen untuk semuanya.
         Beige rata terbaca seperti warna CSS bawaan; butiran tipis membuatnya
         terasa seperti hasil cetak. Sengaja `fixed` dan bukan per-section:
         butiran yang ikut menggulung akan terbaca sebagai tekstur benda,
         bukan sebagai lapisan film. -->
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
