---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/sections.css';
import { brand } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${brand.role} — ${brand.person} | ${brand.name}${brand.symbol}`,
  description = brand.tagline,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="js-loading">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#d5cfbe" />
    <link rel="canonical" href={Astro.site} />

    <link rel="preload" href="/fonts/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-900.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Harus inline dan di <head>: GhostEngine hanya bisa mengukur posisi awal
         saat scroll benar-benar nol. Modul yang di-defer sudah terlambat —
         browser keburu memulihkan posisi scroll sebelumnya. -->
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      addEventListener('beforeunload', () => window.scrollTo(0, 0));
    </script>
  </head>
  <body>
    <slot />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
