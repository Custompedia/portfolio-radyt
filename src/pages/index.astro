---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Journey from '../components/sections/Journey.astro';
import Companies from '../components/sections/Companies.astro';
import Network from '../components/sections/Network.astro';
import SoutheastAsia from '../components/sections/SoutheastAsia.astro';
import Work from '../components/sections/Work.astro';
import Moment from '../components/sections/Moment.astro';
import Contact from '../components/sections/Contact.astro';
import VentureDock from '../components/VentureDock.astro';
---

<Base>
  <Sidebar />
  <main>
    <Hero />
    <About />
    <Journey />
    <Companies />
    <Network />
    <SoutheastAsia />
    <Moment />
    <Work />
  </main>
  <!-- Contact merangkap footer: wordmark penutup + satu blok CTA, lalu halaman
       selesai. Kontak dan sosial tetap permanen di sidebar. -->
  <Contact />
  <VentureDock />
</Base>
